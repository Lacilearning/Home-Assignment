{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "pageObjects/**/*.ts",
    "tests/EndpointValidation/**/*.ts",
    "testData/**/*.ts",
    "tests/**/*.ts"
  ]
}